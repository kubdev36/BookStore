@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<h1 class="text-danger">Đã xảy ra lỗi.</h1>
<h2 class="text-danger">Có lỗi khi xử lý yêu cầu của bạn.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Mã yêu cầu:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Chế độ phát triển</h3>
<p>
    Khi chuyển sang môi trường <strong>Development</strong>, hệ thống sẽ hiển thị thêm thông tin chi tiết về lỗi.
</p>
<p>
    <strong>Không nên bật chế độ Development trên môi trường vận hành thực tế.</strong>
    Việc này có thể làm lộ thông tin nhạy cảm của hệ thống cho người dùng cuối.
</p>
