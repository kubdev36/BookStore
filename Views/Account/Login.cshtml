@model BookStore.Models.LoginInputModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<main class="authx-page">
    <section class="authx-main">
        <div class="container dc-container authx-container">
            <div class="row g-5 align-items-start">
                <div class="col-lg-6">
                    <div class="authx-brand">THE DIGITAL CURATOR</div>
                    <h1 class="authx-hero-title">Không gian dành cho<br />những người yêu sách.</h1>
                    <p class="authx-hero-copy">
                        Truy cập bộ sưu tập đã tuyển chọn, các ấn bản giới hạn và hành trình đọc của riêng bạn.
                    </p>

                    <figure class="authx-hero-figure">
                        <img src="https://images.unsplash.com/photo-1507842217343-583bb7270b66?w=1200&auto=format&fit=crop" alt="Kệ sách" />
                        <figcaption>"Cuốn sách bạn đọc xong sẽ không còn là cuốn sách lúc bắt đầu."</figcaption>
                    </figure>
                </div>

                <div class="col-lg-6">
                    <section class="authx-card">
                        <h2>Đăng nhập</h2>
                        <p class="authx-card-sub">Chào mừng bạn quay lại thư viện của mình.</p>

                        <form asp-action="Login" method="post" class="authx-form">
                            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                            <div class="authx-field">
                                <label asp-for="Email">Email</label>
                                <input asp-for="Email" class="form-control" placeholder="tenban@email.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="authx-field">
                                <label asp-for="Password">Mật khẩu</label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="........" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="authx-row">
                                <div class="form-check">
                                    <input asp-for="RememberMe" class="form-check-input" />
                                    <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                                </div>
                                <a href="#" class="authx-muted-link">Quên mật khẩu?</a>
                            </div>

                            <button type="submit" class="authx-submit">Đăng nhập</button>
                        </form>

                        <div class="authx-social-wrap">
                            <span>Hoặc đăng nhập nhanh</span>
                            <div class="authx-social-buttons">
                                <form asp-action="ExternalLogin" method="post" class="authx-social-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="provider" value="Google" />
                                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                                    <button type="submit" class="authx-social-btn authx-social-google">
                                        <svg class="authx-social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                            <path fill="#EA4335" d="M12 10.2v3.9h5.5c-.2 1.3-1.5 3.8-5.5 3.8-3.3 0-6-2.8-6-6.2s2.7-6.2 6-6.2c1.9 0 3.1.8 3.8 1.5l2.6-2.5C16.8 2.9 14.6 2 12 2 6.9 2 2.8 6.5 2.8 12s4.1 10 9.2 10c5.3 0 8.9-3.8 8.9-9.1 0-.6-.1-1.1-.2-1.7H12z" />
                                            <path fill="#34A853" d="M3.8 7.3l3.2 2.4C7.8 8 9.7 6.6 12 6.6c1.9 0 3.1.8 3.8 1.5l2.6-2.5C16.8 2.9 14.6 2 12 2 8.5 2 5.5 4.1 3.8 7.3z" />
                                            <path fill="#FBBC05" d="M12 22c2.5 0 4.7-.8 6.3-2.3l-2.9-2.4c-.8.6-1.9 1-3.4 1-2.6 0-4.8-1.8-5.6-4.2l-3.3 2.5C4.8 19.9 8.1 22 12 22z" />
                                            <path fill="#4285F4" d="M21 12.9c0-.6-.1-1.1-.2-1.7H12v3.9h5.5c-.3 1.6-1.2 2.7-2.1 3.4l2.9 2.4c1.7-1.6 2.7-4 2.7-7z" />
                                        </svg>
                                        <span>Google</span>
                                    </button>
                                </form>
                                <form asp-action="ExternalLogin" method="post" class="authx-social-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="provider" value="Facebook" />
                                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                                    <button type="submit" class="authx-social-btn authx-social-facebook">
                                        <svg class="authx-social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                            <path fill="#1877F2" d="M24 12.1C24 5.4 18.6 0 12 0S0 5.4 0 12.1c0 6 4.4 11 10.1 11.9v-8.4H7.1v-3.5h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.6.2 2.6.2v2.9h-1.5c-1.5 0-2 .9-2 1.9v2.3h3.4l-.5 3.5h-2.9V24C19.6 23.1 24 18.1 24 12.1z" />
                                        </svg>
                                        <span>Facebook</span>
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="authx-join-wrap">
                            <p>Bạn chưa có tài khoản?</p>
                            <a asp-action="Register" asp-route-returnUrl="@ViewBag.ReturnUrl" class="authx-join-link">Đăng ký ngay</a>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </section>

    <footer class="authx-footer">
        <div class="container dc-container authx-foot-inner">
            <span>© 2024 THE DIGITAL CURATOR. ĐÃ ĐĂNG KÝ BẢN QUYỀN.</span>
            <div>
                <a href="#">Chính sách bảo mật</a>
                <a href="#">Điều khoản dịch vụ</a>
                <a href="#">Hỗ trợ</a>
            </div>
        </div>
    </footer>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


