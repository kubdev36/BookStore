@model IReadOnlyList<BookStore.Models.Order>
@{
    ViewData["Title"] = "Đơn hàng";
    var totalOrders = Model.Count;
    var totalRevenue = Model.Sum(x => x.TotalAmount);
}

<section class="adminx-wrap">
    <aside class="adminx-sidebar">
        <div>
            <a asp-controller="Books" asp-action="Index" class="adminx-brand">Quản lý kho sách</a>
            <div class="adminx-role">Quản trị biên tập</div>
        </div>

        <nav class="adminx-menu">
            <a class="adminx-menu-item" asp-action="Dashboard">Bảng điều khiển</a>
            <a class="adminx-menu-item" asp-action="Index">Kho sách</a>
            <a class="adminx-menu-item active" asp-action="Orders">Đơn hàng</a>
        </nav>

        <div class="adminx-side-foot">
            <a class="adminx-menu-item" asp-controller="Home" asp-action="Privacy">Hỗ trợ</a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="adminx-signout">Đăng xuất</button>
            </form>
        </div>
    </aside>

    <div class="adminx-main ordx-main">
        <header class="adminx-topbar">
            <div>
                <h1>The Digital Curator</h1>
                <div class="adminx-tabs">
                    <a asp-action="Dashboard">Bảng điều khiển</a>
                    <span class="active">Báo cáo</span>
                </div>
            </div>
            <div class="invx-tools">
                <input type="text" placeholder="Tìm kiếm đơn hàng..." />
                <span>&#128276;</span>
                <span>&#9881;</span>
                <span class="adminx-avatar">@User.Identity?.Name?.FirstOrDefault().ToString().ToUpperInvariant()</span>
            </div>
        </header>

        <section class="ordx-headline">
            <div>
                <p class="invx-breadcrumb">ĐƠN HÀNG &nbsp;&rsaquo;&nbsp; SỔ GIAO DỊCH</p>
                <h2>Danh sách đơn hàng</h2>
                <p>Theo dõi toàn bộ đơn hàng đã xác nhận và sẵn sàng giao.</p>
            </div>
            <div class="ordx-metrics">
                <div>
                    <span>Tổng số đơn hàng</span>
                    <strong>@totalOrders</strong>
                </div>
                <div>
                    <span>Tổng doanh thu</span>
                    <strong>@totalRevenue.ToString("N0") VND</strong>
                </div>
            </div>
        </section>

        <section class="invx-table-wrap ordx-table-wrap">
            <div class="table-responsive">
                <table class="table invx-table ordx-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th class="text-end">Tổng tiền</th>
                            <th>Thời gian tạo</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">Chưa có đơn hàng nào.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var order in Model)
                            {
                                <tr>
                                    <td class="ordx-ref">#ORD-@order.Id</td>
                                    <td>
                                        <div class="adminx-collector">
                                            <span class="adminx-mini-avatar">@order.CustomerName.FirstOrDefault().ToString().ToUpperInvariant()</span>
                                            @order.CustomerName
                                        </div>
                                    </td>
                                    <td>@order.Email</td>
                                    <td>@order.Phone</td>
                                    <td class="text-end invx-price">@order.TotalAmount.ToString("N0")</td>
                                    <td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end">
                                        <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-dark">Chi tiết</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</section>
